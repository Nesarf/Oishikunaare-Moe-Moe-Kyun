{
  "name": "oishikunaare-moe-moe-kyun",
  "displayName": "Oishikunaare-Moe-Moe-Kyun",
  "version": "0.12.0",
  "description": "Output house rules and an optional moe layer for every DeepSeek Harness agent: no check-mark or cross glyphs, no emoji, a kaomoji habit, and - when switched on - a tri-lingual moe voice over replies, thinking, commands, subagents and the work products themselves. One global prompt section, so every preset, workspace and subagent obeys without a single preset edit.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "house-rules",
    "kaomoji",
    "emoji-ban",
    "output-discipline",
    "moe",
    "voice"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "adapters",
    "bin",
    "cordis.patch.yml",
    "lib",
    "rules",
    "scripts",
    "src",
    "test"
  ],
  "bin": {
    "mmk": "bin/mmk.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./portable": "./src/portable.mjs",
    "./transcripts": "./src/transcripts.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen": "npm run gen:rules && npm run gen:kaomoji && npm run gen:voices",
    "gen:rules": "node scripts/gen-rules-json.mjs",
    "gen:kaomoji": "node scripts/gen-kaomoji.mjs",
    "selfcheck": "node test/selfcheck.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:generated": "npm run gen:rules -- --check && npm run gen:kaomoji -- --check && npm run gen:voices -- --check",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check:ascii && npm run check:portable && npm run check:version && npm run check:generated && npm run build && npm run selfcheck && npm run acceptance && npm run test:portable",
    "acceptance": "node test/acceptance.mjs",
    "test:portable": "node test/portable.mjs",
    "mmk": "node bin/mmk.mjs",
    "mcp": "node adapters/mcp.mjs",
    "claude-code": "node adapters/claude-code.mjs",
    "bench:thinking": "node bench/thinking-language.mjs",
    "audit:session": "node scripts/audit-session.mjs",
    "check:text": "node scripts/check-text.mjs",
    "gen:voices": "node scripts/gen-voices.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nesarf/Oishikunaare-Moe-Moe-Kyun.git"
  },
  "bugs": {
    "url": "https://github.com/Nesarf/Oishikunaare-Moe-Moe-Kyun/issues"
  },
  "homepage": "https://github.com/Nesarf/Oishikunaare-Moe-Moe-Kyun#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
