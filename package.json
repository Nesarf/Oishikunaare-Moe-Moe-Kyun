{
  "name": "TastyLineOut",
  "version": "0.7.0",
  "description": "Output house rules for every DeepSeek Harness agent: no check-mark or cross glyphs in replies, your own thinking, or written files, and a kaomoji habit in conversation and thinking - one global prompt section, all presets, all workspaces.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "house-rules",
    "system-prompt",
    "kaomoji",
    "output-discipline"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "lib",
    "rules",
    "scripts",
    "src",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen": "npm run gen:rules && npm run gen:kaomoji",
    "gen:rules": "node scripts/gen-rules-json.mjs",
    "gen:kaomoji": "node scripts/gen-kaomoji.mjs",
    "selfcheck": "node test/selfcheck.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:generated": "npm run gen:rules -- --check && npm run gen:kaomoji -- --check",
    "verify": "npm run check:ascii && npm run check:version && npm run check:generated && npm run build && npm run selfcheck && npm run acceptance",
    "acceptance": "node test/acceptance.mjs",
    "audit:session": "node scripts/audit-session.mjs",
    "check:text": "node scripts/check-text.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nesarf/TastyLineOut.git"
  },
  "bugs": {
    "url": "https://github.com/Nesarf/TastyLineOut/issues"
  },
  "homepage": "https://github.com/Nesarf/TastyLineOut#readme",
  "engines": {
    "node": ">=20"
  }
}
