{
  "name": "oishikunaare-moe-moe-kyun",
  "displayName": "Oishikunaare-Moe-Moe-Kyun",
  "version": "0.63.0",
  "description": "Output house rules for an AI agent - no check-mark or cross glyphs, no emoji, a kaomoji habit, and the language it thinks in - with an optional tri-lingual moe voice layer. One core, four entries: a CLI (mmk), an MCP server, a Claude Code hook, and a DeepSeek Harness plugin that reaches every preset, workspace and subagent from one global prompt section.",
  "keywords": [
    "house-rules",
    "kaomoji",
    "emoji-ban",
    "output-discipline",
    "prompt",
    "moe",
    "voice",
    "cli",
    "mcp",
    "claude-code",
    "hook",
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "adapters",
    "bin",
    "cordis.patch.yml",
    "icon.png",
    "lib",
    "rules",
    "scripts",
    "src",
    "test"
  ],
  "bin": {
    "mmk": "bin/mmk.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./portable": "./src/portable.mjs",
    "./transcripts": "./src/transcripts.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen": "npm run gen:rules && npm run gen:kaomoji && npm run gen:voices",
    "gen:rules": "node scripts/gen-rules-json.mjs",
    "gen:kaomoji": "node scripts/gen-kaomoji.mjs",
    "selfcheck": "node test/selfcheck.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:generated": "npm run gen:rules -- --check && npm run gen:kaomoji -- --check && npm run gen:voices -- --check",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check:ascii && npm run check:portable && npm run check:version && npm run check:generated && npm run build && npm run selfcheck && npm run acceptance && npm run test:portable && npm run test:adapters && npm run test:client-patch",
    "acceptance": "node test/acceptance.mjs",
    "test:portable": "node test/portable.mjs",
    "test:adapters": "node test/adapters.mjs",
    "test:client-patch": "node test/client-patch.mjs",
    "mmk": "node bin/mmk.mjs",
    "mcp": "node adapters/mcp.mjs",
    "claude-code": "node adapters/claude-code.mjs",
    "bench:thinking": "node bench/thinking-language.mjs",
    "bench:rules": "node test/bench.mjs",
    "audit:session": "node scripts/audit-session.mjs",
    "check:text": "node scripts/check-text.mjs",
    "gen:voices": "node scripts/gen-voices.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nesarf_Mollor/Oishikunaare-Moe-Moe-Kyun.git"
  },
  "bugs": {
    "url": "https://github.com/Nesarf_Mollor/Oishikunaare-Moe-Moe-Kyun/issues"
  },
  "homepage": "https://github.com/Nesarf_Mollor/Oishikunaare-Moe-Moe-Kyun#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
